{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoppy",
  "version": "0.2.0",
  "identifier": "com.clixmods.hoppy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popup",
        "url": "index.html",
        "title": "Hoppy",
        "width": 640,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Summon AI anywhere with a shortcut or a mouse button",
    "category": "Productivity",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4RDg5NzVFQ0NDREQzQkIKUldTNzA4M01YcGZZV0ZZUjVURUlRRW1HTVVYTVVPTElteXdDZkpaQzJxVDJRMStrbnFWOEExLy8K",
      "endpoints": ["https://github.com/clixmods/hoppy/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
